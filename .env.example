# ============================================================================
#  IDMP configuration
#
#  Copy this file to `.env` in this same directory (the repo root):
#
#      cp .env.example .env
#
#  One file configures both the API server and the web app. Everything here
#  has a working default, so the system runs with the file untouched — the
#  only thing you probably want to fill in is GEMINI_API_KEY.
#
#  Restart the API after any change; it reads this file once at startup.
#  Real environment variables always win over this file, so
#  `PORT=5000 npm run dev:api` still overrides PORT below.
#
#  This file is committed. `.env` is gitignored — never put a real key here.
# ============================================================================


# ----------------------------------------------------------------------------
#  Schema generation and the LLM tutor            [optional, but recommended]
# ----------------------------------------------------------------------------
#
#  Powers two things only:
#    - the "Type a prompt. Get a database." panel
#    - the Explain buttons and the tutor's follow-up questions
#
#  Everything else works without it: deploying schemas, type-safe forms,
#  validation, querying, and the whole CSV import path. Leave it blank and the
#  prompt panel shows a warning instead of failing silently.
#
#  Get a free key: https://aistudio.google.com/apikey
#
GEMINI_API_KEY=

#  Change this if the model name above is retired or you want a different tier.
#  Nothing else needs to change.
GEMINI_MODEL=gemini-2.5-flash


# ----------------------------------------------------------------------------
#  Where records are stored                                       [optional]
# ----------------------------------------------------------------------------
#
#  memory  Starts a throwaway MongoDB inside the API process. Nothing to
#          install. Every schema and record is DISCARDED when the server
#          stops — re-run `npm run seed` to get the sample data back.
#          This is the default so the project runs on a clean machine.
#
#  a URI   A real MongoDB, e.g. mongodb://127.0.0.1:27017
#          or an Atlas connection string. Data persists.
#
MONGODB_URI=memory

#  Database name inside that MongoDB. Collections are created per schema as
#  data_<AppId>_<FormId>, alongside apps_info and form_schema.
MONGODB_DB=idmp


# ----------------------------------------------------------------------------
#  API server                                                     [optional]
# ----------------------------------------------------------------------------
PORT=4441

#  127.0.0.1 accepts connections from this machine only. Use 0.0.0.0 to expose
#  the API on your network — only do that together with IDMP_API_KEYS below.
HOST=127.0.0.1


# ----------------------------------------------------------------------------
#  Authentication                                        [off by default]
# ----------------------------------------------------------------------------
#
#  Leave this unset and the API runs OPEN: no credentials required, and every
#  write is attributed to the user `usr_local`. Anyone who can reach the port
#  has full read and write access. That is fine on localhost, and wrong
#  anywhere else.
#
#  Set it to comma-separated `key:userId` pairs to require a credential:
#
#      IDMP_API_KEYS=sk-demo-abc123:usr_demo,sk-agent-xyz789:usr_agent
#
#  Callers then send either header:
#      Authorization: Bearer sk-demo-abc123
#      x-api-key: sk-demo-abc123
#
#  Writes are stamped with that key's userId. A schema created with
#  `ownerScoped: true` additionally filters every read to the caller's own
#  records.
#
#  NOTE: the web app does not send a key — it has no sign-in screen. Turning
#  this on secures the API but stops the browser UI from working. It is meant
#  for a hosted deployment driven by agents, or as the first half of adding
#  real accounts.
#
# IDMP_API_KEYS=


# ----------------------------------------------------------------------------
#  Web app                                                        [optional]
# ----------------------------------------------------------------------------
#
#  Where the browser sends its requests. Change this only if you moved the API
#  off localhost or off the port above. Must be reachable from the BROWSER,
#  not from the server. Requires a web restart, not just a page refresh.
#
NEXT_PUBLIC_IDMP_API=http://localhost:4441/no-code-db-api
